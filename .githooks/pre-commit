#!/usr/bin/env bash
# Pre-commit hook: auto-sync .github/ → .claude/rules/*.md and AGENTS.md
# Install: git config core.hooksPath .githooks

# Check whether any generator input under .github/ is staged
if git diff --cached --name-only | grep -qE '^\.github/(instructions/|AGENTS\.base\.md)'; then
  echo "Syncing .claude/rules/ and AGENTS.md from .github/..."
  # Abort the commit if generation fails — otherwise the `git add` below would
  # stage whatever stale output is still on disk.
  make sync-instructions || exit 1

  # Stage the regenerated files. instruction-sync.md is hand-maintained and is
  # never regenerated by the sync, so the hook leaves its staging state alone
  # entirely — touching it would sweep the author's unstaged edits into an
  # instructions-only commit.
  for f in .claude/rules/*.md; do
    [ "$(basename "$f")" = "instruction-sync.md" ] && continue
    git add "$f"
  done
  git add AGENTS.md
fi
